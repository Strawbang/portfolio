---
import FrenchBaseLayout from "../../layouts/FrenchBaseLayout.astro";
import Home from "../../components/Home.astro";
import SchemaOrgPerson from "../../components/SchemaOrgPerson.astro";
import WebSiteSchema from "../../components/WebSiteSchema.astro";
import { indexLabels } from '../../data/pages';
import { contact } from '../../data/about';

const l = indexLabels['fr'];
---

<FrenchBaseLayout title={l.metaTitle} description={l.metaDescription}>
  <Home lang="fr" />

  <WebSiteSchema slot="head" lang="fr" />

  <SchemaOrgPerson
    name="Djamel Bougouffa"
    jobTitle="Ingénieur logiciel"
    description={l.metaDescription}
    image="https://djamel-bougouffa.com/assets/at-work.webp"
    url="https://djamel-bougouffa.com/fr/"
    email={contact.email}
    telephone={contact.phone}
    sameAs={[contact.github, contact.linkedin]}
    knowsLanguage={["fr", "en"]}
    availableForHire={true}
  />
</FrenchBaseLayout>
