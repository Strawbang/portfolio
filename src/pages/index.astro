---
import BaseLayout from "../layouts/BaseLayout.astro";
import Home from "../components/Home.astro";
import SchemaOrgPerson from "../components/SchemaOrgPerson.astro";
import WebSiteSchema from "../components/WebSiteSchema.astro";
import { indexLabels } from "../data/pages";
import { contact } from "../data/about";

const l = indexLabels['en'];
---

<BaseLayout title={l.metaTitle} description={l.metaDescription}>
  <Home lang="en" />

  <WebSiteSchema slot="head" lang="en" />

  <!-- Données structurées pour les IA comme ChatGPT -->
  <SchemaOrgPerson
    name="Djamel Bougouffa"
    jobTitle="Software Engineer"
    description="Software engineer with 7+ years of experience, based in France and open to remote roles with international teams. Designs and builds AI tooling for large, long-lived codebases. At Ippon Technologies he built an internal AI platform for legacy modernization (Rust CLI, web app and MCP server), rolled out to 120+ consultants. Maintains semtree, open-source semantic code search in Rust."
    image="https://djamel-bougouffa.com/assets/at-work.webp"
    url="https://djamel-bougouffa.com/about/"
    email={contact.email}
    sameAs={["https://github.com/strawbang", "https://www.linkedin.com/in/djamel-bougouffa/"]}
    knowsAbout={["Rust", "TypeScript", "Tree-sitter", "RAG", "MCP", "LLM Integration", "Semantic code search", "React", "Node.js", "Angular", "Java", "CI/CD", "Docker"]}
    worksFor={{ name: "Ippon Technologies", url: "https://www.ippon.fr/" }}
    alumniOf={[
      { name: "Institut F2I", url: "https://www.f2i-institute.com/", description: "Master's degree in computer engineering / Expert Architect Web", startDate: "2020", endDate: "2021" },
      { name: "Institut F2I", url: "https://www.f2i-institute.com/", description: "Bachelor's degree in computer engineering / Digital Project Manager", startDate: "2018", endDate: "2020" },
      { name: "IRIS - Ecole supérieure d'informatique", description: "Diploma of Advanced Technician Solutions and Business Applications", startDate: "2017", endDate: "2018" },
    ]}
    knowsLanguage={["en", "fr"]}
    seeks="Remote software engineering roles, from France, with French or international teams, in AI tooling, developer tools and products built on large codebases."
    availableForHire={true}
  />
</BaseLayout>
