---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="Contact | Djamel Bougouffa"
  description="Get in touch with Djamel Bougouffa, software engineer based in France. Open to new opportunities, collaborations, and technical discussions."
>
  <div class="stack gap-20">
    <main id="main-content" class="wrapper contact">
      <Hero
        title="Get in touch"
        tagline="For a role, a project or a technical question. I usually reply within two days."
        align="start"
      />

      <div class="contact-layout">
        <div class="form-section">
          <form
            name="contact"
            method="POST"
            action="/contact/success/"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="contact-form"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div class="field">
              <label for="name">Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="John Doe" />
            </div>

            <div class="field">
              <label for="email">Email <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="john@example.com" />
            </div>

            <div class="field">
              <label for="subject">Subject</label>
              <input type="text" id="subject" name="subject" placeholder="Job opportunity, project, question…" />
            </div>

            <div class="field">
              <label for="message">Message <span class="required">*</span></label>
              <textarea id="message" name="message" required rows="6" placeholder="Tell me what's on your mind…"></textarea>
            </div>

            <button type="submit" class="submit-btn">
              Send message
            </button>

          </form>
        </div>

        <aside class="info-section" aria-label="Contact information">
          <div class="info-card">
            <h3>Email</h3>
            <a href="mailto:dbougouffa@gmail.com">dbougouffa@gmail.com</a>
          </div>
          <div class="info-card">
            <h3>LinkedIn</h3>
            <a href="https://www.linkedin.com/in/djamel-bougouffa" target="_blank" rel="noopener noreferrer">
              djamel-bougouffa
            </a>
          </div>
          <div class="info-card">
            <h3>GitHub</h3>
            <a href="https://github.com/strawbang" target="_blank" rel="noopener noreferrer">
              strawbang
            </a>
          </div>
          <div class="info-card availability">
            <h3>Availability</h3>
            <p>Open to remote roles with French and international teams.</p>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>


<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .hidden {
    display: none;
  }

  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 600;
  }

  .required {
    color: var(--accent-regular);
  }

  input,
  textarea {
    background-color: var(--surface);
    border: 1px solid var(--gray-700);
    border-radius: 0.5rem;
    color: var(--gray-0);
    font-family: inherit;
    font-size: var(--text-md);
    padding: 0.75rem 1rem;
    transition: border-color 0.2s ease;
    width: 100%;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--gray-600);
  }

  input:focus,
  textarea:focus {
    border-color: var(--accent-regular);
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-regular) 20%, transparent);
  }

  @media (forced-colors: active) {
    input:focus,
    textarea:focus {
      outline: 3px solid ButtonText;
      outline-offset: 1px;
    }
  }

  textarea {
    resize: vertical;
    min-height: 160px;
  }

  .submit-btn {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--accent-regular);
    color: var(--accent-text-over);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.1;
    padding: 0.8em 1.3em;
    transition: background-color var(--theme-transition);
  }

  .submit-btn:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--accent-regular) 84%, black);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .info-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    background-color: var(--surface);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    padding: 1.1rem 1.25rem;
  }

  .info-card h3 {
    color: var(--gray-0);
    font-size: var(--text-md);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .info-card a {
    color: var(--gray-0);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent-regular);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
    transition: color var(--theme-transition);
  }

  .info-card a:hover {
    color: var(--link-color);
  }

  .info-card p {
    color: var(--gray-300);
    font-size: var(--text-sm);
  }

  .availability {
    border-left: 3px solid var(--accent-regular);
  }

  @media (min-width: 50em) {
    .contact {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .contact > :global(:first-child) {
      grid-column-start: 2;
    }

    .contact-layout {
      grid-column: 2 / 4;
      flex-direction: row;
      align-items: flex-start;
    }

    .form-section {
      flex: 2;
    }

    .info-section {
      flex: 1;
    }
  }
</style>
