---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import CallToAction from "../components/CallToAction.astro";
import SchemaOrgPerson from '../components/SchemaOrgPerson.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import FaqSection from '../components/FaqSection.astro';
import { experiences, education, skills, spokenLanguages, contact, resumeFiles, aboutLabels, aboutFaq } from '../data/about';

const l = aboutLabels['en'];
const resume = resumeFiles['en'];
const faq = aboutFaq['en'];
---

<BaseLayout title={l.metaTitle} description={l.metaDescription}>
  <div class="stack gap-20">
    <main id="main-content" class="wrapper about">
      <Hero title={l.title} tagline={l.tagline}>
        <img width="1553" height="873" src="/assets/at-work.webp" alt={l.imgAlt} />
      </Hero>

      <section class="section-container">
        <h2 class="section-title">{l.sectionBackground}</h2>
        <div class="content">
          <p>{l.backgroundIntro}</p>
          <CareerTimeline
            currentLabel="Current"
            items={experiences.map(exp => ({
              title: exp.company,
              href: exp.slug ? `/work/${exp.slug}` : undefined,
              subtitle: exp.role['en'],
              period: exp.period['en'],
              description: exp.description['en'],
              isCurrent: exp.period['en'].toLowerCase().includes('present'),
            }))}
          />
          <p>{l.backgroundOutro}</p>
          <a class="cta-link" href="/work/">{l.seeAllExperiences}</a>
        </div>
      </section>

      <section class="section-container">
        <h2 class="section-title">{l.sectionEducation}</h2>
        <div class="content">
          <CareerTimeline
            items={education.map(edu => ({
              title: edu.degree['en'],
              subtitle: edu.field['en'],
              period: edu.period,
              extra: edu.institution,
            }))}
          />
        </div>
      </section>

      <section class="section-container">
        <h2 class="section-title">{l.sectionSkills}</h2>
        <div class="content">
          <div class="skills-grid">
            <div class="skill-category">
              <h3>{l.skillFrontend}</h3>
              <ul class="skill-list">{skills.frontend.map(s => <li>{s}</li>)}</ul>
            </div>
            <div class="skill-category">
              <h3>{l.skillBackend}</h3>
              <ul class="skill-list">{skills.backend.map(s => <li>{s}</li>)}</ul>
            </div>
            <div class="skill-category">
              <h3>{l.skillAi}</h3>
              <ul class="skill-list">{skills.ai.map(s => <li>{s}</li>)}</ul>
            </div>
            <div class="skill-category">
              <h3>{l.skillDevops}</h3>
              <ul class="skill-list">{skills.devops.map(s => <li>{s}</li>)}</ul>
            </div>
            <div class="skill-category">
              <h3>{l.skillMethodologies}</h3>
              <ul class="skill-list">{skills.methodologies.map(s => <li>{s}</li>)}</ul>
            </div>
            <div class="skill-category">
              <h3>{l.skillArchitecture}</h3>
              <ul class="skill-list">{skills.architecture.map(s => <li>{s}</li>)}</ul>
            </div>
            <div class="skill-category">
              <h3>{l.skillTools}</h3>
              <ul class="skill-list">{skills.tools.map(s => <li>{s}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section-container">
        <h2 class="section-title">{l.sectionLanguages}</h2>
        <div class="content">
          <div class="languages-grid">
            {spokenLanguages.map(sl => (
              <div class="language-item">
                <h3>{sl.name}</h3>
                <p>{sl.level['en']}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section-container">
        <h2 class="section-title">{l.sectionContact}</h2>
        <div class="content">
          <div class="contact-grid">
            <div class="contact-item">
              <h3>Email</h3>
              <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
            </div>
            <div class="contact-item">
              <h3>Phone</h3>
              <p><a href={`tel:${contact.phone}`}>{contact.phone}</a></p>
            </div>
            <div class="contact-item">
              <h3>LinkedIn</h3>
              <p><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">{contact.linkedin.replace('https://', '')}</a></p>
            </div>
            <div class="contact-item">
              <h3>GitHub</h3>
              <p><a href={contact.github} target="_blank" rel="noopener noreferrer">{contact.github.replace('https://', '')}</a></p>
            </div>
            <div class="contact-item">
              <h3>Portfolio</h3>
              <p><a href={contact.portfolio} target="_blank" rel="noopener noreferrer">{contact.portfolio.replace('https://', '')}</a></p>
            </div>
          </div>
        </div>
      </section>

      <section class="section-container">
        <h2 class="section-title">{l.sectionResume}</h2>
        <div class="content">
          <p>{l.resumeText}</p>
          <CallToAction href={resume}>
            {l.resumeDownload}
          </CallToAction>
        </div>
      </section>
      <FaqSection heading={faq.heading} items={faq.items} />
    </main>

    <ContactCTA />
  </div>

  <SchemaOrgPerson
    name="Djamel Bougouffa"
    jobTitle="Software Engineer"
    description="Software engineer with 7+ years of experience, based in France and open to remote roles with international teams. Designs and builds AI tooling for large, long-lived codebases. At Ippon Technologies he built an internal AI platform for legacy modernization (Rust CLI, web app and MCP server), rolled out to 120+ consultants. Maintains semtree, open-source semantic code search in Rust."
    image="https://djamel-bougouffa.com/assets/at-work.webp"
    url="https://djamel-bougouffa.com/about/"
    email={contact.email}
    telephone={contact.phone}
    sameAs={[contact.github, contact.linkedin, "https://twitter.com/strawbang", "https://dev.to/strawbang", "https://medium.com/@strawbang"]}
    knowsLanguage={["en", "fr"]}
    workLocation={{ name: "France (remote)" }}
    worksFor={{ name: "Ippon Technologies", url: "https://www.ippon.fr/" }}
    knowsAbout={["TypeScript", "React", "Angular", "Node.js", "Java", "Spring Boot", "Rust", "RAG", "GenAI", "MCP", "LLM Integration", "DevOps", "Docker", "Kubernetes", "Next.js"]}
    seeks="Remote software engineering roles, from France, with French or international teams, in AI tooling, developer tools and products built on large codebases."
    availableForHire={true}
  />
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 0.75rem;
  }

  .section-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
    margin-bottom: 2rem;
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--gray-800);
    padding-bottom: 0.5rem;
  }

  .content {
    grid-column: 2 / 4;
  }

  .content h3 {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--gray-0);
    font-size: var(--text-md);
    margin-bottom: 0.5rem;
  }

  .skills-grid, .languages-grid, .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .skill-category, .language-item, .contact-item {
    background-color: var(--surface);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
  }

  .skill-list {
    list-style-type: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
  }

  .skill-list li {
    margin-bottom: 0.25rem;
    padding-left: 1rem;
    position: relative;
  }

  .skill-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-regular);
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  .content .cta-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--gray-0);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent-regular);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .content .cta-link:hover {
    color: var(--link-color);
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    .section-container {
      display: contents;
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 50em) {
    .skills-grid, .languages-grid, .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
