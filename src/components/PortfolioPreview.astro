---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
const slug = id.replace(/\.md$/, '');
const isFr = slug.startsWith('fr/');
const href = isFr ? `/fr/experiences/${slug.replace('fr/', '')}` : `/work/${slug}`;
const keywords = data.keywords?.slice(0, 4) ?? [];

const locale = isFr ? 'fr-FR' : 'en-US';
const presentLabel = isFr ? 'Présent' : 'Present';

function formatDate(date: Date) {
	return date.toLocaleDateString(locale, { month: 'short', year: 'numeric' });
}

const period = data.startDate
	? `${formatDate(data.startDate)} – ${data.endDate ? formatDate(data.endDate) : presentLabel}`
	: null;

const engagementLabel = data.engagementType
	? data.engagementType === 'esn'
		? 'ESN'
		: data.engagementType === 'company'
			? (isFr ? 'Entreprise' : 'Company')
			: data.engagementType === 'opensource'
				? 'Open source'
				: (isFr ? 'Mission client' : 'Client mission')
	: null;

const contextLabel = data.context
	? data.context === 'legacy'
		? 'Legacy'
		: data.context === 'greenfield'
			? 'Greenfield'
			: (isFr ? 'Hybride' : 'Hybrid')
	: null;
---

<article class="card">
	<a href={href} class="card-link">
		<div class={`image-container${data.imgType === 'logo' ? ' logo' : ''}`}>
			<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" width="600" height="338" />
		</div>
		<div class="card-body">
			<div class="title-row">
				<h3 class="title">{data.title}</h3>
				{engagementLabel && <span class={`engagement-badge ${data.engagementType}`}>{engagementLabel}</span>}
			</div>
			{data.role && <p class="role">{data.role}</p>}
			{period && <p class="period">{period}</p>}
			{(data.workplace || contextLabel) && (
				<div class="meta-row">
					{data.workplace && <span class="meta-item">{data.workplace}</span>}
					{contextLabel && <span class="meta-item">{contextLabel}</span>}
				</div>
			)}
			{keywords.length > 0 && (
				<footer>
					{keywords.map((k) => <span class="tag">{k}</span>)}
				</footer>
			)}
		</div>
	</a>
</article>

<style>
	.card {
		height: 100%;
		border-radius: 0.75rem;
		background-color: var(--surface);
		border: 1px solid var(--gray-800);
		overflow: hidden;
		transition: border-color var(--theme-transition);
	}

	.card:hover {
		border-color: var(--gray-600);
	}

	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.image-container {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background-color: var(--gray-900);
		border-bottom: 1px solid var(--gray-800);
	}

	.image-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.image-container.logo img {
		object-fit: contain;
		padding: 1.75rem;
	}

	.card-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.1rem 1.25rem 1.25rem;
		gap: 0.3rem;
	}

	.title-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.title {
		font-size: var(--text-lg);
		color: var(--gray-0);
		transition: color var(--theme-transition);
	}

	.card:hover .title {
		color: var(--link-color);
	}

	.role {
		font-size: var(--text-sm);
		color: var(--gray-200);
		font-weight: 500;
	}

	.period {
		font-size: var(--text-sm);
		color: var(--gray-400);
		font-variant-numeric: tabular-nums;
	}

	.meta-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.meta-item {
		font-size: var(--text-xs);
		color: var(--gray-400);
	}

	.engagement-badge {
		font-size: var(--text-xs);
		font-weight: 600;
		padding: 0.1rem 0.45rem;
		border-radius: 0.3rem;
		border: 1px solid var(--gray-800);
		color: var(--gray-300);
		white-space: nowrap;
	}

	.engagement-badge.opensource,
	.engagement-badge.client {
		color: var(--link-color);
		border-color: color-mix(in srgb, var(--accent-regular) 35%, transparent);
	}

	footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: auto;
		padding-top: 0.9rem;
	}

	.tag {
		font-size: var(--text-xs);
		color: var(--gray-300);
		background-color: var(--gray-900);
		padding: 0.15rem 0.5rem;
		border-radius: 0.3rem;
		line-height: 1.6;
	}
</style>
