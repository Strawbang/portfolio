---
interface Props {
	teamSize?: string;
	companySize?: string;
	context?: 'legacy' | 'greenfield' | 'hybrid';
	workplace?: 'Remote' | 'Hybrid' | 'On-site';
	keywords?: string[];
	stack?: Record<string, string[]>;
	isFr?: boolean;
}

const { teamSize, companySize, context, workplace, keywords, stack, isFr = false } = Astro.props;

const contextLabel: Record<string, { en: string; fr: string }> = {
	legacy:     { en: 'Legacy codebase', fr: 'Codebase legacy' },
	greenfield: { en: 'Greenfield',      fr: 'Greenfield' },
	hybrid:     { en: 'Hybrid',          fr: 'Hybride' },
};

const items = [
	teamSize    && (isFr ? `Équipe ${teamSize}` : `Team ${teamSize}`),
	companySize && (isFr ? `${companySize} employés` : `${companySize} employees`),
	context     && (isFr ? contextLabel[context].fr : contextLabel[context].en),
	workplace,
].filter(Boolean) as string[];

const stackEntries = stack ? Object.entries(stack) : null;
const hasContent = items.length > 0 || stackEntries?.length || (keywords && keywords.length > 0);
---

{hasContent && (
	<div class="context-card">
		{items.length > 0 && (
			<ul class="context-items" role="list">
				{items.map((item) => <li>{item}</li>)}
			</ul>
		)}
		{stackEntries && stackEntries.length > 0 && (
			<dl class="stack-categories">
				{stackEntries.map(([category, techs]) => (
					<div class="stack-row">
						<dt>{category}</dt>
						<dd>{techs.map((t) => <span class="stack-pill">{t}</span>)}</dd>
					</div>
				))}
			</dl>
		)}
		{!stackEntries && keywords && keywords.length > 0 && (
			<dl class="stack-categories">
				<div class="stack-row">
					<dt>Stack</dt>
					<dd>{keywords.map((k) => <span class="stack-pill">{k}</span>)}</dd>
				</div>
			</dl>
		)}
	</div>
)}

<style>
	.context-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.1rem 1.25rem;
		background-color: var(--surface);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.context-items {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--gray-200);
	}

	.stack-categories {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.stack-row {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		align-items: baseline;
		gap: 0.75rem;
	}

	dt {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	dd {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin: 0;
	}

	.stack-pill {
		background-color: var(--gray-900);
		color: var(--gray-200);
		padding: 0.1rem 0.5rem;
		border-radius: 0.3rem;
		font-size: var(--text-xs);
		line-height: 1.7;
	}
</style>
