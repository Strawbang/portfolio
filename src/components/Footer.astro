---
const currentYear = new Date().getFullYear();
---

<footer class="wrapper" aria-label="Site footer">
  <div class="inner">
    <p>&copy; {currentYear} Djamel Bougouffa. Built with <a href="https://astro.build/">Astro</a>.</p>
    <p class="links">
      <a href="/uses">Uses</a>
      <a href="https://www.linkedin.com/in/djamel-bougouffa">LinkedIn</a>
      <a href="https://github.com/strawbang">GitHub</a>
      <a href="https://github.com/rustkit-ai">rustkit-ai</a>
      <a href="https://dev.to/strawbang">Dev.to</a>
      <a href="https://medium.com/@strawbang">Medium</a>
      <a href="/rss.xml">RSS</a>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--gray-800);
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  a {
    color: var(--gray-300);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition), color var(--theme-transition);
  }

  a:hover,
  a:focus-visible {
    color: var(--gray-0);
    text-decoration-color: var(--accent-regular);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  @media (min-width: 50em) {
    .inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }
</style>
