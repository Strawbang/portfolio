---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  slugs: string[];
  lang: 'en' | 'fr';
}

const { slugs, lang } = Astro.props;

const allWork = await getCollection('work');

const relatedWork = slugs
  .map(slug => {
    const id = lang === 'fr' ? `fr/${slug}` : slug;
    return allWork.find(w => w.id.replace(/\.md$/, '') === id);
  })
  .filter((w): w is CollectionEntry<'work'> => w !== undefined);

const label = lang === 'fr' ? 'Expérience liée' : 'Related experience';
const basePath = lang === 'fr' ? '/fr/experiences' : '/work';
---

{relatedWork.length > 0 && (
  <section class="related-work">
    <h2 class="section-title">{label}</h2>
    <div class="cards-grid">
      {relatedWork.map(work => {
        const workSlug = work.id.replace(/\.md$/, '').replace(/^fr\//, '');
        const url = `${basePath}/${workSlug}/`;
        return (
          <a href={url} class="card">
            <div class={`card-img-wrap${work.data.imgType === 'logo' ? ' logo' : ''}`}>
              <img src={work.data.img} alt={work.data.img_alt || work.data.title} loading="lazy" decoding="async" width="600" height="338" />
            </div>
            <div class="card-body">
              <h3 class="card-title">{work.data.title}</h3>
              <p class="card-desc">{work.data.description.trim()}</p>
              {work.data.keywords && (
                <div class="card-tags">
                  {work.data.keywords.slice(0, 4).map(k => (
                    <span class="tag">{k}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .related-work {
    padding-block: 2.5rem;
    border-top: 1px solid var(--gray-800);
  }

  .section-title {
    font-size: var(--text-xl);
    color: var(--gray-0);
    margin-bottom: 1.5rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border-radius: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--gray-800);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--theme-transition);
  }

  .card:hover {
    border-color: var(--gray-600);
  }

  .card-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--gray-900);
    border-bottom: 1px solid var(--gray-800);
  }

  .card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-img-wrap.logo img {
    object-fit: contain;
    padding: 1.5rem;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
    padding: 1rem 1.25rem 1.25rem;
  }

  .card-title {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--gray-0);
    line-height: 1.3;
    transition: color var(--theme-transition);
  }

  .card:hover .card-title {
    color: var(--link-color);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--gray-300);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    text-wrap: wrap;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .tag {
    background-color: var(--gray-900);
    color: var(--gray-300);
    padding: 0.1rem 0.5rem;
    border-radius: 0.3rem;
    font-size: var(--text-xs);
    line-height: 1.7;
  }
</style>
