---
import type { Article } from '../types/article';

export interface Props {
  article: Article;
}

const { article } = Astro.props;

const DEFAULT_IMAGES: Record<string, string> = {
  'Dev.to': '/assets/devto-logo.png',
  'Medium': '/assets/medium-logo.png',
  'Blog': '/assets/blog-logo.png',
  fallback: '/assets/placeholder-article.jpg'
};

const imageUrl = article.imageUrl || DEFAULT_IMAGES[article.platform] || DEFAULT_IMAGES.fallback;
const locale = Astro.url.pathname.startsWith('/fr') ? 'fr-FR' : 'en-GB';
const displayDate = article.publishDate.toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' });
const external = article.platform !== 'Blog';
const platforms = external ? (article.platforms ?? [article.platform]) : [];
---

<article class="card">
  <a href={article.url} target={external ? '_blank' : '_self'} rel={external ? 'noopener noreferrer' : ''} class="card-link">
    <div class="image-container">
      <img
        src={imageUrl}
        alt={article.imageAlt || ''}
        loading="lazy"
        decoding="async"
        width="600"
        height="338"
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      />
    </div>
    <div class="card-body">
      <p class="meta">
        <time datetime={article.publishDate.toISOString()}>{displayDate}</time>
        {platforms.length > 0 && <span>{platforms.join(', ')}</span>}
      </p>
      <h3 class="title">{article.title}</h3>
      <p class="description">{article.description}</p>
    </div>
  </a>
</article>

<style>
  .card {
    height: 100%;
    border-radius: 0.75rem;
    background-color: var(--surface);
    border: 1px solid var(--gray-800);
    overflow: hidden;
    transition: border-color var(--theme-transition);
  }

  .card:hover {
    border-color: var(--gray-600);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .image-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--gray-900);
    border-bottom: 1px solid var(--gray-800);
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 1.1rem 1.25rem 1.35rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--gray-400);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-size: var(--text-lg);
    line-height: 1.25;
    color: var(--gray-0);
    transition: color var(--theme-transition);
  }

  .card:hover .title {
    color: var(--link-color);
  }

  .description {
    color: var(--gray-300);
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    text-wrap: wrap;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
