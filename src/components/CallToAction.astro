---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a href={href}><slot /></a>

<style>
	a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6em;
		width: fit-content;
		padding: 0.8em 1.3em;
		color: var(--accent-text-over);
		background: var(--accent-regular);
		border-radius: 0.5rem;
		font-weight: 600;
		font-size: var(--text-md);
		line-height: 1.1;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color var(--theme-transition);
	}

	a:hover {
		background: color-mix(in srgb, var(--accent-regular) 84%, black);
	}

	a:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 3px;
	}
</style>
