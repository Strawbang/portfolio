---
// Renders a visible FAQ accordion AND the matching FAQPage JSON-LD.
// Used for AEO: AI answer engines (ChatGPT, Perplexity, Google AI Overviews)
// prefer extracting and citing question/answer pairs.
import type { FaqItem } from '../data/about';

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="faq">
  <h2 class="section-title">{heading}</h2>
  <div class="faq-list">
    {items.map((item, i) => (
      <details class="faq-item" open={i === 0}>
        <summary>
          <span class="faq-question">{item.question}</span>
          <span class="faq-chevron" aria-hidden="true"></span>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: var(--text-xl);
    color: var(--gray-0);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--gray-800);
    padding-bottom: 0.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Match the About page's desktop layout: the parent `.about` is a
     `1fr 60% 1fr` grid where section titles sit in the left rail and content
     spans the wide area. Mirror that so the FAQ aligns with the other sections
     instead of collapsing into the narrow left column. */
  @media (min-width: 50em) {
    .faq {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
      column-gap: 0;
      margin-bottom: 0;
    }

    .section-title {
      grid-column: 1;
      align-self: start;
    }

    .faq-list {
      grid-column: 2 / 4;
    }
  }

  .faq-item {
    background-color: var(--gray-999);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    box-shadow: var(--shadow-sm);
    padding: 0 1.5rem;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .faq-item:hover {
    box-shadow: var(--shadow-md);
  }

  .faq-item[open] {
    border-color: var(--accent-regular);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    cursor: pointer;
    padding: 1.25rem 0;
    list-style: none;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--gray-0);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] summary {
    color: var(--accent-regular);
  }

  .faq-question {
    line-height: 1.35;
  }

  .faq-chevron {
    flex-shrink: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 2px solid var(--accent-regular);
    border-bottom: 2px solid var(--accent-regular);
    transform: rotate(45deg);
    transform-origin: center;
    margin-top: -0.25rem;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(-135deg);
    margin-top: 0.15rem;
  }

  .faq-answer {
    padding-bottom: 1.5rem;
  }

  .faq-answer p {
    margin: 0;
    color: var(--gray-300);
    line-height: 1.7;
    max-width: 68ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron,
    .faq-item {
      transition: none;
    }
  }
</style>
