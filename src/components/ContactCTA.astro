---
import CallToAction from "./CallToAction.astro";
import { getLangFromUrl } from '../i18n/utils';
import { contact } from '../data/about';

const lang = getLangFromUrl(Astro.url);

const copy = lang === 'fr'
  ? {
      title: 'Vous recrutez pour un poste en remote ?',
      text: "Écrivez-moi avec le poste et quelques mots sur l'équipe. Je réponds en général sous deux jours.",
      button: "M'écrire",
    }
  : {
      title: 'Hiring for a remote engineering role?',
      text: 'Email me with the role and a few words about the team. I usually reply within two days.',
      button: 'Email me',
    };
---

<aside class="wrapper" aria-labelledby="cta-heading">
  <div class="inner">
    <h2 id="cta-heading">{copy.title}</h2>
    <p>{copy.text}</p>
    <CallToAction href={`mailto:${contact.email}`}>{copy.button}</CallToAction>
  </div>
</aside>

<style>
  .inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block: 3.5rem;
    border-top: 1px solid var(--gray-800);
  }

  h2 {
    font-size: var(--text-2xl);
    max-width: 20ch;
  }

  p {
    color: var(--gray-300);
    max-width: 52ch;
  }

  @media (min-width: 50em) {
    .inner {
      padding-block: 5rem;
    }

    h2 {
      font-size: var(--text-3xl);
    }
  }
</style>
