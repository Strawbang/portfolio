{
  "$meta": {
    "name": "Djamel Bougouffa Design System",
    "source": "djamel-bougouffa.com",
    "description": "Design tokens extracted from the portfolio source (global.css + components). Dark-first, violet accent.",
    "themes": ["light", "dark"]
  },
  "color": {
    "gray": {
      "light": {
        "0": "#090b11", "50": "#141925", "100": "#283044", "200": "#3d4663",
        "300": "#505d84", "400": "#5e6d9e", "500": "#8490b5", "600": "#a3acc8",
        "700": "#c3cadb", "800": "#e3e6ee", "900": "#f3f4f7", "999": "#ffffff"
      },
      "dark": {
        "0": "#ffffff", "50": "#f3f4f7", "100": "#e3e6ee", "200": "#c3cadb",
        "300": "#a3acc8", "400": "#8490b5", "500": "#6474a2", "600": "#505d84",
        "700": "#3d4663", "800": "#283044", "900": "#141925", "999": "#090b11"
      }
    },
    "accent": {
      "light": { "light": "#a78bfa", "regular": "#6d28d9", "dark": "#2e1065" },
      "dark":  { "light": "#2e1065", "regular": "#6d28d9", "dark": "#a78bfa" },
      "overlay": "hsla(263, 80%, 65%, 0.25)",
      "subtleOverlayDark": "hsla(263, 60%, 35%, 0.33)"
    },
    "semantic": {
      "light": {
        "background": "var(--gray-999)",
        "text": "var(--gray-200)",
        "heading": "var(--gray-100)",
        "link": "#6d28d9",
        "textOverAccent": "#ffffff"
      },
      "dark": {
        "background": "#090b11",
        "text": "#c3cadb",
        "heading": "#e3e6ee",
        "link": "#a78bfa",
        "textOverAccent": "#ffffff"
      }
    }
  },
  "gradient": {
    "accent": "linear-gradient(150deg, var(--accent-light), var(--accent-regular), var(--accent-dark))",
    "accentDarkTheme": "linear-gradient(150deg, #5b21b6, #6d28d9, #a78bfa)",
    "subtleLight": "linear-gradient(150deg, #f3f4f7 19%, #ffffff 150%)",
    "subtleDark": "linear-gradient(150deg, #141925 19%, #090b11 81%)",
    "strokeLight": "linear-gradient(180deg, #f3f4f7, #c3cadb)",
    "strokeDark": "linear-gradient(180deg, #505d84, #283044)"
  },
  "typography": {
    "fontFamily": {
      "brand": "'Rubik', system-ui, sans-serif",
      "body": "'Public Sans', system-ui, sans-serif"
    },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "heading": 1.1, "body": 1.5 },
    "scale": {
      "sm":   { "rem": "0.875rem", "px": 14 },
      "base": { "rem": "1rem",     "px": 16 },
      "md":   { "rem": "1.125rem", "px": 18 },
      "lg":   { "rem": "1.25rem",  "px": 20 },
      "xl":   { "rem": "1.625rem", "px": 26 },
      "2xl":  { "rem": "2.125rem", "px": 34 },
      "3xl":  { "rem": "2.625rem", "px": 42 },
      "4xl":  { "rem": "3.5rem",   "px": 56 },
      "5xl":  { "rem": "4.5rem",   "px": 72 }
    },
    "headings": {
      "h1": "5xl", "h2": "4xl", "h3": "3xl", "h4": "2xl", "h5": "xl"
    }
  },
  "spacing": {
    "base": "0.5rem",
    "scale": {
      "2": "0.5rem", "4": "1rem", "8": "2rem", "10": "2.5rem",
      "15": "3.75rem", "20": "5rem", "30": "7.5rem", "48": "12rem"
    }
  },
  "radius": {
    "card": "0.5rem",
    "panel": "0.6rem",
    "pill": "999rem"
  },
  "shadow": {
    "light": {
      "sm": "0px 6px 3px rgba(9,11,17,0.01), 0px 4px 2px rgba(9,11,17,0.01), 0px 2px 2px rgba(9,11,17,0.02), 0px 0px 1px rgba(9,11,17,0.03)",
      "md": "0px 28px 11px rgba(9,11,17,0.01), 0px 16px 10px rgba(9,11,17,0.03), 0px 7px 7px rgba(9,11,17,0.05), 0px 2px 4px rgba(9,11,17,0.06)",
      "lg": "0px 62px 25px rgba(9,11,17,0.01), 0px 35px 21px rgba(9,11,17,0.05), 0px 16px 16px rgba(9,11,17,0.1), 0px 4px 9px rgba(9,11,17,0.12)"
    },
    "dark": {
      "sm": "0px 6px 3px rgba(255,255,255,0.01), 0px 4px 2px rgba(255,255,255,0.01), 0px 2px 2px rgba(255,255,255,0.02), 0px 0px 1px rgba(255,255,255,0.03)",
      "md": "0px 28px 11px rgba(255,255,255,0.01), 0px 16px 10px rgba(255,255,255,0.03), 0px 7px 7px rgba(255,255,255,0.05), 0px 2px 4px rgba(255,255,255,0.06)",
      "lg": "0px 62px 25px rgba(255,255,255,0.01), 0px 35px 21px rgba(255,255,255,0.05), 0px 16px 16px rgba(255,255,255,0.1), 0px 4px 9px rgba(255,255,255,0.12)"
    }
  },
  "motion": {
    "themeTransition": "0.2s ease-in-out"
  },
  "components": {
    "button": {
      "background": "var(--gradient-accent)",
      "color": "var(--accent-text-over)",
      "radius": "999rem",
      "paddingSm": "0.56em 2em",
      "paddingLg": "1.125rem 2.5rem",
      "shadow": "var(--shadow-md)",
      "fontSize": "var(--text-lg) to var(--text-xl)"
    },
    "pill": {
      "background": "var(--accent-regular)",
      "border": "1px solid var(--accent-regular)",
      "color": "var(--accent-text-over)",
      "radius": "999rem",
      "padding": "0.5rem 1rem",
      "fontSize": "var(--text-md)"
    },
    "card": {
      "background": "var(--gray-999)",
      "border": "1px solid var(--gray-800)",
      "radius": "0.5rem",
      "hover": "translateY(-5px) + var(--shadow-md)",
      "titleHoverColor": "var(--accent-regular)"
    },
    "nav": {
      "background": "radial-gradient(var(--gray-900), var(--gray-800) 150%)",
      "border": "var(--gradient-stroke)",
      "radius": "999rem",
      "activeBackground": "var(--accent-regular)"
    }
  }
}
